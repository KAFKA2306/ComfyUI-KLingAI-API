{
  "schema_version": 1,
  "goal": "VRChat向けの小さなカフェ。カップの3D生成と360度背景の参照候補を管理する。",
  "workflows": [
    {
      "id": "cup-hunyuan3d",
      "repository": "Comfy-Org/workflow_templates",
      "path": "templates/3d_hunyuan3d_image_to_model.json",
      "purpose": "入力画像からコーヒーカップのGLBを生成する候補",
      "mode": "local",
      "output": "GLB",
      "hardware_validation": "not-tested",
      "commercial_terms": "review-upstream-model-license"
    },
    {
      "id": "cup-trellis2",
      "repository": "Comfy-Org/workflow_templates",
      "path": "templates/3d_pixal3d_trellis2_image_to_model.json",
      "purpose": "メッシュとテクスチャ生成の代替候補",
      "mode": "local",
      "output": "3D mesh",
      "hardware_validation": "not-tested",
      "commercial_terms": "review-upstream-model-license"
    },
    {
      "id": "panorama-qwen",
      "repository": "Comfy-Org/workflow_templates",
      "path": "templates/template_qwen_Image_2512_360_lora.json",
      "purpose": "カフェ背景の360度画像を作る参照候補。衝突判定には使わない",
      "mode": "local",
      "output": "PNG panorama",
      "hardware_validation": "not-tested",
      "commercial_terms": "review-upstream-model-license"
    }
  ]
}
