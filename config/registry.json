  "pipelines": [
    {
      "id": "lyrics-sync-jizura",
      "title": "歌詞と音源から文字PV",
      "purpose": "音源と確定歌詞を同期し、JIZURAでリリック動画を制作",
      "tags": [
        "LRC",
        "歌詞",
        "文字PV"
      ],
      "mission_ids": [
        "youtube",
        "movies"
      ],
      "inputs": [
        "song.mp3",
        "lyrics.txt"
      ],
      "steps": [
        {
          "tool": "syncalong",
          "source_url": "https://github.com/wickeddoc/syncalong",
          "requires": [
            "song.mp3",
            "lyrics.txt"
          ],
          "provides": [
            "lyrics.lrc"
          ],
          "action": "歌詞を音源に合わせてLRCへ変換"
        },
        {
          "tool": "JIZURA",
          "source_url": "https://github.com/852wa/JIZURA",
          "requires": [
            "song.mp3",
            "lyrics.lrc"
          ],
          "provides": [
            "lyric-video.mp4",
            "lyric-overlay.transparent-png"
          ],
          "action": "LRCと音源を読み込みMP4か透過PNG連番を書き出す"
        }
      ],
      "outputs": [
        "lyric-video.mp4",
        "lyric-overlay.transparent-png"
      ],
      "checks": [
        "歌詞と開始時刻を試聴確認する",
        "演出と文字の欠けを確認する",
        "音源・歌詞の公開利用権を確認する"
      ]
    },
    {
      "id": "audio-only-jizura",
      "title": "音源から歌詞を推定して文字PV",
      "purpose": "歌詞のない音源からLRCを作成し、手で校正して映像化",
      "tags": [
        "音声認識",
        "LRC",
        "文字PV"
      ],
      "mission_ids": [
        "youtube",
        "movies"
      ],
      "inputs": [
        "song.mp3"
      ],
      "steps": [
        {
          "tool": "audio-lyrics",
          "source_url": "https://github.com/blizzardcldasl/audio-lyrics-skill",
          "requires": [
            "song.mp3"
          ],
          "provides": [
            "lyrics.lrc"
          ],
          "action": "Whisperを使い歌詞と時刻を抽出する"
        },
        {
          "tool": "JIZURA",
          "source_url": "https://github.com/852wa/JIZURA",
          "requires": [
            "song.mp3",
            "lyrics.lrc"
          ],
          "provides": [
            "lyric-video.mp4"
          ],
          "action": "校正したLRCで文字PVを生成する"
        }
      ],
      "outputs": [
        "lyric-video.mp4"
      ],
      "checks": [
        "歌唱の誤認識・歌詞欠落と時刻を修正する",
        "音源・歌詞の公開利用権を確認する"
      ]
    },
    {
      "id": "lyrics-sync-usesuno",
      "title": "歌詞MVの別スタイル生成",
      "purpose": "同期済みLRCと音源をMV Studioで装飾し動画にする",
      "tags": [
        "LRC",
        "MV",
        "背景"
      ],
      "mission_ids": [
        "youtube",
        "movies"
      ],
      "inputs": [
        "song.mp3",
        "lyrics.txt"
      ],
      "steps": [
        {
          "tool": "syncalong",
          "source_url": "https://github.com/wickeddoc/syncalong",
          "requires": [
            "song.mp3",
            "lyrics.txt"
          ],
          "provides": [
            "lyrics.lrc"
          ],
          "action": "音源と歌詞を同期させる"
        },
        {
          "tool": "UseSuno MV Studio",
          "source_url": "https://github.com/UseSuno/UseSunoMVStudio",
          "requires": [
            "song.mp3",
            "lyrics.lrc"
          ],
          "provides": [
            "lyric-mv.mp4",
            "lyric-mv.webm"
          ],
          "action": "背景とアニメーションを選択して映像を書き出す"
        }
      ],
      "outputs": [
        "lyric-mv.mp4",
        "lyric-mv.webm"
      ],
      "checks": [
        "歌詞時刻と字幕表示を確認する",
        "ブラウザの動画エンコーダーへの対応を確認する"
      ]
    },
    {
      "id": "background-video-lyric-pv",
      "title": "背景映像と文字PVの合成",
      "purpose": "ComfyUIなどが出力した動画を背景素材にして歌詞を重ねる",
      "tags": [
        "映像合成",
        "ComfyUI連携",
        "LRC"
      ],
      "mission_ids": [
        "youtube",
        "movies"
      ],
      "inputs": [
        "background.mp4",
        "song.mp3",
        "lyrics.txt"
      ],
      "steps": [
        {
          "tool": "syncalong",
          "source_url": "https://github.com/wickeddoc/syncalong",
          "requires": [
            "song.mp3",
            "lyrics.txt"
          ],
          "provides": [
            "lyrics.lrc"
          ],
          "action": "歌詞の行頭時刻をLRCにする"
        },
        {
          "tool": "Phrasync",
          "source_url": "https://github.com/jaydemks/phrasync",
          "requires": [
            "background.mp4",
            "song.mp3",
            "lyrics.lrc"
          ],
          "provides": [
            "lyric-composite.mp4"
          ],
          "action": "動画を背景トラックに置き、歌詞の演出と音源を合わせる"
        }
      ],
      "outputs": [
        "lyric-composite.mp4"
